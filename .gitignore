# ================================================================
# AgroVision-QC-Pipeline — .gitignore
# ================================================================

# ----- Python bytecode & cache -----
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# ----- Virtual environments -----
venv/
.venv/
env/
.env
.env.*

# ----- Model checkpoints & serialized models -----
*.pth
*.pt
*.pkl
*.h5
*.onnx
*.model
*.ckpt

# ----- Experiment outputs (regenerables) -----


# ----- Data directories (too large for Git) -----
data/raw/
data/processed/
data/processed_fruit/
data/processed_quality/

# ----- Compressed archives -----
*.zip
*.tar.gz
*.7z
*.rar

# ----- Jupyter Notebook checkpoints -----
.ipynb_checkpoints/

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- OS files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Logs -----
*.log
